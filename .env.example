# --- Supabase (session pooler) ---
DB_HOST=
DB_PORT=5432
DB_NAME=postgres
DB_USER=
DB_PASSWORD=
DB_SSLMODE=require

# --- Local PostgreSQL (instead of the values above) ---
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=agriinfo
# DB_USER=postgres
# DB_PASSWORD=your-local-password
# DB_SSLMODE=disable

# --- Error display ---
# "local" shows PHP errors on the screen while you develop.
# Leave this line OUT on the hosting server so visitors never see errors.
APP_ENV=local